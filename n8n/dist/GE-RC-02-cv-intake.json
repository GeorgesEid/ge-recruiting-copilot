                      "id":  "10378105-45e9-31ff-cf80-f89cf85cc32c",
                      "name":  "Read CV (OpenAI)",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       440,
