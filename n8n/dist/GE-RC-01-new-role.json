                                     },
                      "id":  "87efd992-4d21-0ffb-2a3d-9b045cee2319",
                      "name":  "Write JD (OpenAI)",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       440,
                                       300
                                   ],
                      "maxTries":  3,
                      "retryOnFail":  true,
                      "waitBetweenTries":  3000,
                      "credentials":  {
                                          "openAiApi":  {
                                                            "id":  "KGGzkxLN8GkZRZ9e",
                                                            "name":  "GE-RC OpenAI"
                                                        }
                                      }
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "// GE-RC-01 · Reads the AI\u0027s job description and turns it into a database row + readable text.\nconst jd = JSON.parse($json.choices[0].message.content);\nconst bullets = (a) =\u003e (a || []).map((x) =\u003e `• ${x}`).join(\u0027\\n\u0027);\nconst parts = [\n  `*${jd.title}* · ${jd.client}`,\n  jd.summary,\n  `*What you\u0027ll do*\\n${bullets(jd.responsibilities)}`,\n  `*Must have*\\n${bullets(jd.must_have)}`,\n  jd.nice_to_have.length ? `*Nice to have*\\n${bullets(jd.nice_to_have)}` : \u0027\u0027,\n  `*Schedule:* ${jd.schedule}\\n*Pay:* ${jd.compensation}\\n*Start:* ${jd.start_date}\\n*Type:* ${jd.employment_type}`,\n  jd.to_confirm.length ? `*To confirm with the client before posting*\\n${bullets(jd.to_confirm)}` : \u0027\u0027,\n].filter(Boolean);\n\nreturn [{ json: {\n  client: jd.client, title: jd.title, transcript: $(\u0027Build JD request\u0027).first().json.transcript,\n  jd, jd_text: parts.join(\u0027\\n\\n\u0027), search_query: jd.search_query, status: \u0027pending_approval\u0027,\n} }];\n"
                                     },
                      "id":  "e1a8e7ac-3b62-b658-35bc-3fa5d05b85d8",
                      "name":  "Check JD",
                      "type":  "n8n-nodes-base.code",
