                      "parameters":  {
                                         "jsCode":  "// GE-RC-04/05 · Proves the request really comes from OUR Slack app (signing secret + timestamp, Slack\u0027s official method).\n// n8n blocks the crypto module here, so HMAC-SHA256 is written out in plain JavaScript.\n// The signing secret is read from Supabase at run time, so it never appears in this workflow file.\nfunction rotr(x, n) { return (x \u003e\u003e\u003e n) | (x \u003c\u003c (32 - n)); }\nfunction sha256(data) {\n  const K = [0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5, 0xd807aa98, 0x12835b01,\n    0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174, 0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f,\n    0x4a7484aa, 0x5cb0a9dc, 0x76f988da, 0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,\n    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85, 0xa2bfe8a1, 0xa81a664b, 0xc24b8b70,\n    0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070, 0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a,\n    0x5b9cca4f, 0x682e6ff3, 0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2];\n  const H = [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19];\n  const bytes = data.slice();\n  const bitLen = data.length * 8;\n  bytes.push(0x80);\n  while (bytes.length % 64 !== 56) bytes.push(0);\n  for (let i = 7; i \u003e= 0; i--) bytes.push(Math.floor(bitLen / Math.pow(2, i * 8)) \u0026 0xff);\n  const W = new Array(64);\n  for (let off = 0; off \u003c bytes.length; off += 64) {\n    for (let t = 0; t \u003c 16; t++) W[t] = ((bytes[off + 4 * t] \u003c\u003c 24) | (bytes[off + 4 * t + 1] \u003c\u003c 16) | (bytes[off + 4 * t + 2] \u003c\u003c 8) | bytes[off + 4 * t + 3]) \u003e\u003e\u003e 0;\n    for (let t = 16; t \u003c 64; t++) {\n      const s0 = rotr(W[t - 15], 7) ^ rotr(W[t - 15], 18) ^ (W[t - 15] \u003e\u003e\u003e 3);\n      const s1 = rotr(W[t - 2], 17) ^ rotr(W[t - 2], 19) ^ (W[t - 2] \u003e\u003e\u003e 10);\n      W[t] = (W[t - 16] + s0 + W[t - 7] + s1) \u003e\u003e\u003e 0;\n    }\n    let [a, b, c, d, e, f, g, h] = H;\n    for (let t = 0; t \u003c 64; t++) {\n      const t1 = (h + (rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25)) + ((e \u0026 f) ^ (~e \u0026 g)) + K[t] + W[t]) \u003e\u003e\u003e 0;\n      const t2 = ((rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22)) + ((a \u0026 b) ^ (a \u0026 c) ^ (b \u0026 c))) \u003e\u003e\u003e 0;\n      h = g; g = f; f = e; e = (d + t1) \u003e\u003e\u003e 0; d = c; c = b; b = a; a = (t1 + t2) \u003e\u003e\u003e 0;\n    }\n    [a, b, c, d, e, f, g, h].forEach((v, i) =\u003e { H[i] = (H[i] + v) \u003e\u003e\u003e 0; });\n  }\n  const out = [];\n  for (const x of H) out.push(x \u003e\u003e\u003e 24, (x \u003e\u003e\u003e 16) \u0026 255, (x \u003e\u003e\u003e 8) \u0026 255, x \u0026 255);\n  return out;\n}\nfunction hmacSha256Hex(key, msg) {\n  let k = Array.from(Buffer.from(key, \u0027utf8\u0027));\n  if (k.length \u003e 64) k = sha256(k);\n  while (k.length \u003c 64) k.push(0);\n  const inner = sha256(k.map((x) =\u003e x ^ 0x36).concat(Array.from(Buffer.from(msg, \u0027utf8\u0027))));\n  return sha256(k.map((x) =\u003e x ^ 0x5c).concat(inner)).map((x) =\u003e x.toString(16).padStart(2, \u00270\u0027)).join(\u0027\u0027);\n}\n\nconst settings = Object.fromEntries($(\u0027Load settings\u0027).all().map((i) =\u003e [i.json.key, i.json.value]));\nconst hook = $(\u0027Slack webhook\u0027).first();\nconst headers = hook.json.headers || {};\nconst ts = Number(headers[\u0027x-slack-request-timestamp\u0027] || 0);\nconst raw = Buffer.from((hook.binary \u0026\u0026 hook.binary.data \u0026\u0026 hook.binary.data.data) || \u0027\u0027, \u0027base64\u0027).toString(\u0027utf8\u0027);\nconst expected = \u0027v0=\u0027 + hmacSha256Hex(settings.slack_signing_secret || \u0027\u0027, `v0:${ts}:${raw}`);\nif (!settings.slack_signing_secret || Math.abs(Date.now() / 1000 - ts) \u003e 300 || expected !== headers[\u0027x-slack-signature\u0027]) {\n  return [];   // not from our Slack app (or a replay): do nothing\n}\nconst form = hook.json.body || {};\n\n// GE-RC-05 · (after slack-verify.js) Reads which button was clicked.\nconst payload = JSON.parse(form.payload || \u0027{}\u0027);\nconst a = (payload.actions || [])[0];\nif (!a) return [];\nconst user = (payload.user \u0026\u0026 (payload.user.username || payload.user.name)) || \u0027recruiter\u0027;\nconst [kind, verb] = String(a.action_id).split(\u0027_\u0027);            // jd_approve, jd_reject, cand_approve, cand_skip\nif (![\u0027jd\u0027, \u0027cand\u0027].includes(kind)) return [];\nconst [roleId, candidateId] = String(a.value).split(\u0027:\u0027).map(Number);\nreturn [{ json: {\n  kind, user, role_id: roleId, candidate_id: candidateId || null,\n  status: kind === \u0027jd\u0027 ? (verb === \u0027approve\u0027 ? \u0027open\u0027 : \u0027rejected\u0027) : (verb === \u0027approve\u0027 ? \u0027approved\u0027 : \u0027skipped\u0027),\n  channel: payload.channel \u0026\u0026 payload.channel.id, message_ts: payload.message \u0026\u0026 payload.message.ts,\n  settings: Object.fromEntries($(\u0027Load settings\u0027).all().map((i) =\u003e [i.json.key, i.json.value])),\n} }];\n"
                                     },
